#: properties/import-export.c:1678
msgid "The file to import wasn’t a valid OpenVPN client configuration"
msgstr "Fila som skal importerast var ikkje eit gyldig OpenVPN-klientoppsett"

#: properties/import-export.c:1686
msgid "The file to import wasn’t a valid OpenVPN configuration (no remote)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (ingen "
"remote)"

#: properties/import-export.c:1697
msgid ""
"The file to import wasn’t a valid OpenVPN configuration (--pkcs12 can not be "
"used with --cert or --key)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (--pkcs12 kan"
" ikkje brukast saman med --cert eller --key)"

#: properties/import-export.c:1707
msgid ""
"The file to import wasn’t a valid OpenVPN configuration (--ca can not be "
"PKCS#12 format)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (--ca kan "
"ikkje vere PKCS#12-format)"

#: properties/import-export.c:1716
msgid "The file to import wasn’t a valid OpenVPN configuration (missing --ca)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (manglar "
"--ca)"

#: properties/import-export.c:1726
msgid ""
"The file to import wasn’t a valid OpenVPN configuration (if you use one of --"
"cert or --key, you must use them both)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (viss du "
"brukar éin av --cert eller --key, må du bruke begge)"

#: properties/import-export.c:1737
msgid ""
"The file to import wasn’t a valid OpenVPN configuration (--cert can not be "
"PKCS#12 format.)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (--cert kan "
"ikkje vere i PKCS#12-format.)"

#: properties/import-export.c:1745
msgid ""
"The file to import wasn’t a valid OpenVPN configuration (--key can not be "
"PKCS#12 format.)"
msgstr ""
"Fila som skal importerast var ikkje eit gyldig OpenVPN-oppsett (--key kan "
"ikkje vere i PKCS#12-format.)"

