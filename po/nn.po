#: properties/nm-openvpn-dialog.ui:204
msgid "_Gateway"
msgstr "_Portnar"

#: properties/nm-openvpn-dialog.ui:217
msgid ""
"Remote gateway(s), with optional port and protocol (e.g. "
"ovpn.corp.com:1234:tcp). You can specify multiple hosts for redundancy (use "
"commas or spaces as delimiters).\n"
"config: remote"
msgstr ""
"Ekstern(e) portnar(ar), med valfri port og protokoll (t.d. ovpn.corp.com:1234:tcp). Du kan oppgi fleire vertar for redundans (bruk komma eller mellomrom som skiljeteikn).\n"
"config: remote"

#: properties/nm-openvpn-dialog.ui:250
msgid "Authentication"
msgstr "Autentisering"

#: properties/nm-openvpn-dialog.ui:285 properties/nm-openvpn-dialog.ui:396
#: properties/nm-openvpn-dialog.ui:495
msgid "CA"
msgstr "CA"

#: properties/nm-openvpn-dialog.ui:298 properties/nm-openvpn-dialog.ui:508
msgid "User"
msgstr "Brukar"

#: properties/nm-openvpn-dialog.ui:348 properties/nm-openvpn-dialog.ui:447
msgid "User name"
msgstr "Brukarnamn"

#: properties/nm-openvpn-dialog.ui:360 properties/nm-openvpn-dialog.ui:459
msgid ""
"Password passed to OpenVPN when prompted for it.\n"
"config: auth-user-pass"
msgstr ""
"Passord som vert sendt til OpenVPN når det vert bedt om det.\n"
"config: auth-user-pass"

#: properties/nm-openvpn-dialog.ui:375 properties/nm-openvpn-dialog.ui:474
msgid ""
"Username passed to OpenVPN when prompted for it. If omitted, use the name of "
"the system user that activates the connection.\n"
"config: auth-user-pass"
msgstr ""
"Brukarnamn som vert sendt til OpenVPN når det vert bedt om det. Viss det vert utelate, vert namnet på systembrukaren som slår på tilkoplinga brukt.\n"
"config: auth-user-pass"

#: properties/nm-openvpn-dialog.ui:544
msgid "Remote IP Address"
msgstr "Ekstern IP-adresse"

#: properties/nm-openvpn-dialog.ui:557
msgid "Local IP Address"
msgstr "Lokal IP-adresse"

#: properties/nm-openvpn-dialog.ui:570
msgid "Key Direction"
msgstr "Nøkkelretning"

#: properties/nm-openvpn-dialog.ui:582 properties/nm-openvpn-editor.c:2795
msgid "Static Key"
msgstr "Statisk nøkkel"

#: properties/nm-openvpn-dialog.ui:594
msgid ""
"Pre-shared file for Static Key encryption mode (non-TLS).\n"
"config: static <file>"
msgstr ""
"Førehandsdelt fil for krypteringsmodus med statisk nøkkel (ikkje TLS).\n"
"config: static <file>"

#: properties/nm-openvpn-dialog.ui:637
msgid ""
"IP address of the remote VPN endpoint.\n"
"config: ifconfig <l> <rn>"
msgstr ""
"IP-adressa til det eksterne VPN-endepunktet.\n"
"config: ifconfig <l> <rn>"

#: properties/nm-openvpn-dialog.ui:650
msgid ""
"IP address of the local VPN endpoint.\n"
"config: ifconfig <l> <rn>"
msgstr ""
"IP-adressa til det lokale VPN-endepunktet.\n"
"config: ifconfig <l> <rn>"

#: properties/nm-openvpn-dialog.ui:663
msgid ""
"Direction for Static Key encryption mode (non-TLS).\n"
"If key direction is used, it must be the opposite of that used on the VPN "
"peer. For example, if the peer uses “1”, this connection must use “0”. If "
"you are unsure what value to use, contact your system administrator.\n"
"config: static <file> [direction]"
msgstr ""
"Retning for krypteringsmodus med statisk nøkkel (ikkje TLS).\n"
"Viss nøkkelretning vert brukt, må han vere motsett av den som vert brukt hos VPN-motparten. Til dømes, viss motparten nyttar «1», må denne tilkoplinga bruke «0». Viss du er usikker på kva verdi du skal bruke, ta kontakt med systemadministratoren din.\n"
"config: static <file> [direction]"

#: properties/nm-openvpn-dialog.ui:709
msgid "Type"
msgstr "Type"

#: properties/nm-openvpn-dialog.ui:721
msgid "Select an authentication mode."
msgstr "Vel ein autentiseringsmodus."

#: properties/nm-openvpn-dialog.ui:778
msgid "Ad_vanced…"
msgstr "A_vansert …"

#: properties/nm-openvpn-dialog.ui:852 properties/nm-openvpn-editor.c:1626
msgid "Not required"
msgstr "Ikkje nødvendig"

#: properties/nm-openvpn-dialog.ui:892
msgid "OpenVPN Advanced Options"
msgstr "Avanserte OpenVPN-val"

#: properties/nm-openvpn-dialog.ui:911
msgid "Advanced Properties"
msgstr "Avanserte eigenskapar"

#: properties/nm-openvpn-dialog.ui:919 properties/nm-openvpn-dialog.ui:2910
#: properties/nm-openvpn-dialog.ui:2963 properties/nm-openvpn-dialog.ui:3017
#: properties/nm-openvpn-dialog.ui:3070 properties/nm-openvpn-dialog.ui:3123
msgid "_Cancel"
msgstr "_Avbryt"

#: properties/nm-openvpn-dialog.ui:927
msgid "_Apply"
msgstr "_Bruk"

#: properties/nm-openvpn-dialog.ui:989
msgid "Use custom gateway p_ort"
msgstr "Bruk tilpassa p_ort for portnar"

#: properties/nm-openvpn-dialog.ui:993 properties/nm-openvpn-dialog.ui:1008
msgid ""
"TCP/UDP port number for peer. (Default value when there is no port for "
"gateway).\n"
"config: port"
msgstr ""
"TCP/UDP-portnummer for motparten. (Standardverdi når portnaren ikkje har oppgitt port.)\n"
"config: port"

#: properties/nm-openvpn-dialog.ui:1034
msgid "Use custom _renegotiation interval"
msgstr "Bruk tilpassa _intervall for ny forhandling"

#: properties/nm-openvpn-dialog.ui:1038 properties/nm-openvpn-dialog.ui:1053
msgid ""
"Renegotiate data channel key after the specified number of seconds.\n"
"config: reneg-sec"
msgstr ""
"Forhandle om nøkkelen for datakanalen etter det oppgitte talet på sekund.\n"
"config: reneg-sec"

#: properties/nm-openvpn-dialog.ui:1079
msgid "_Data compression"
msgstr "_Datakomprimering"

#: properties/nm-openvpn-dialog.ui:1083
msgid ""
"Use fast LZO compression.\n"
"config: comp-lzo"
msgstr ""
"Bruk rask LZO-komprimering.\n"
"config: comp-lzo"

#: properties/nm-openvpn-dialog.ui:1098
msgid ""
"Enable or disable outgoing traffic compression\n"
"config: allow-compression asym|yes"
msgstr ""
"Slå på eller av komprimering av utgåande trafikk\n"
"config: allow-compression asym|yes"

#: properties/nm-openvpn-dialog.ui:1146
msgid "Use a _TCP connection"
msgstr "_Bruk ei TCP-tilkopling"

#: properties/nm-openvpn-dialog.ui:1150
msgid ""
"Use TCP for communicating with remote host.\n"
"(This is a default setting only used when no protocol is specified for the "
"gateway.)\n"
"config: proto tcp-client | udp"
msgstr ""
"Bruk TCP for å kommunisere med ekstern vert.\n"
"(Dette er ei standardinnstilling som berre vert brukt når ingen protokoll er oppgjeven for portnaren.)\n"
"config: proto tcp-client | udp"

#: properties/nm-openvpn-dialog.ui:1169
msgid "Set _virtual device type"
msgstr "Vel _type virtuell eining"

#: properties/nm-openvpn-dialog.ui:1173
msgid "Explicitly set virtual device type and name (TUN/TAP)."
msgstr "Set type og namn for virtuell eining (TUN/TAP) eksplisitt."

#: properties/nm-openvpn-dialog.ui:1187
msgid ""
"Explicitly set virtual device type (TUN/TAP).\n"
"config: dev-type tun | tap"
msgstr ""
"Set type for virtuell eining (TUN/TAP) eksplisitt.\n"
"config: dev-type tun | tap"

#: properties/nm-openvpn-dialog.ui:1207
msgid " and _name"
msgstr " og _namn"

#: properties/nm-openvpn-dialog.ui:1222
msgid ""
"Use custom name for TUN/TAP virtual device (instead of default “tun” or "
"“tap”).\n"
"config: dev <name>"
msgstr ""
"Bruk eit eige namn for den virtuelle TUN/TAP-eininga (i staden for standard «tun» eller «tap»).\n"
"config: dev <name>"

#: properties/nm-openvpn-dialog.ui:1246
msgid "Use custom tunnel Maximum Transmission _Unit (MTU)"
msgstr "Bruk tilpassa MTU (Maximum Transmission _Unit) for tunnelen"

#: properties/nm-openvpn-dialog.ui:1250 properties/nm-openvpn-dialog.ui:1265
msgid ""
"Take the TUN device MTU to be the specified value and derive the link MTU "
"from it.\n"
"config: tun-mtu"
msgstr ""
"Bruk den oppgitte verdien som MTU for TUN-eininga og utlei lenkje-MTU frå han.\n"
"config: tun-mtu"

#: properties/nm-openvpn-dialog.ui:1291
msgid "Use custom UDP _fragment size"
msgstr "Bruk tilpassa UDP-_fragmentstorleik"

#: properties/nm-openvpn-dialog.ui:1295 properties/nm-openvpn-dialog.ui:1310
msgid ""
"Enable internal datagram fragmentation with this maximum size.\n"
"config: fragment"
msgstr ""
"Slå på intern fragmentering av datagram med denne maksimale storleiken.\n"
"config: fragment"

#: properties/nm-openvpn-dialog.ui:1331
msgid "Restrict tunnel TCP Maximum _Segment Size (MSS)"
msgstr "Avgrens TCP Maximum _Segment Size (MSS) for tunnelen"

#: properties/nm-openvpn-dialog.ui:1335
msgid ""
"Restrict tunnel TCP MSS.\n"
"config: mssfix"
msgstr ""
"Avgrens TCP MSS for tunnelen.\n"
"config: mssfix"

#: properties/nm-openvpn-dialog.ui:1348
msgid "Rando_mize remote hosts"
msgstr "_Tilfeldig rekkjefølgje på eksterne vertar"

#: properties/nm-openvpn-dialog.ui:1352
msgid ""
"Randomize the order of gateways list (remote) as a kind of basic load-"
"balancing measure.\n"
"config: remote-random"
msgstr ""
"Tilfeldig rekkjefølgje på lista over portnarar (remote) som eit enkelt tiltak for lastbalansering.\n"
"config: remote-random"

#: properties/nm-openvpn-dialog.ui:1365
msgid "Allo_w Pull FQDN"
msgstr "_Tillat Pull FQDN"

#: properties/nm-openvpn-dialog.ui:1369
msgid ""
"Allow client to pull DNS names from server\n"
"config: allow-pull-fqdn"
msgstr ""
"Lèt klienten hente DNS-namn frå tenaren\n"
"config: allow-pull-fqdn"

#: properties/nm-openvpn-dialog.ui:1382
msgid "_Prefix remote DNS name with random string"
msgstr "_Set tilfeldig streng framføre eksternt DNS-namn"

#: properties/nm-openvpn-dialog.ui:1386
msgid ""
"Adds a random string to remote DNS name to avoid DNS caching.\n"
"config: remote-random-hostname"
msgstr ""
"Legg til ein tilfeldig streng i det eksterne DNS-namnet for å unngå DNS-mellomlagring.\n"
"config: remote-random-hostname"

#: properties/nm-openvpn-dialog.ui:1399
msgid "_IPv6 tun link"
msgstr "_IPv6 tun-lenkje"

#: properties/nm-openvpn-dialog.ui:1403
msgid ""
"Build a tun link capable of forwarding IPv6 traffic\n"
"config: tun-ipv6"
msgstr ""
"Byggjer ei tun-lenkje som kan vidaresende IPv6-trafikk\n"
"config: tun-ipv6"

#: properties/nm-openvpn-dialog.ui:1421
msgid "Specify pin_g interval"
msgstr "Oppgje _ping-intervall"

#: properties/nm-openvpn-dialog.ui:1425 properties/nm-openvpn-dialog.ui:1440
msgid ""
"Ping remote over the TCP/UDP control channel if no packets have been sent "
"for at least n seconds.\n"
"config: ping <n>"
msgstr ""
"Ping motparten over TCP/UDP-kontrollkanalen viss ingen pakkar har vorte sende på minst n sekund.\n"
"config: ping <n>"

#: properties/nm-openvpn-dialog.ui:1466
msgid "Specify _exit or restart ping"
msgstr "Oppgje avslutting eller omstart for _ping"

#: properties/nm-openvpn-dialog.ui:1470 properties/nm-openvpn-dialog.ui:1485
#: properties/nm-openvpn-dialog.ui:1505
msgid ""
"Exit or restart after n seconds pass without reception of a ping or other "
"packet from remote.\n"
"config: ping-exit | ping-restart <n>"
msgstr ""
"Avslutt eller start på nytt etter at det har gått n sekund utan at det er motteke ping eller annan pakke frå motparten.\n"
"config: ping-exit | ping-restart <n>"

#: properties/nm-openvpn-dialog.ui:1526
msgid "Accept authenticated packets from any address (F_loat)"
msgstr "Godta autentiserte pakkar frå alle adresser (F_loat)"

#: properties/nm-openvpn-dialog.ui:1530
msgid ""
"Allow remote peer to change its IP address and/or port number, such as due "
"to DHCP (this is the default if --remote is not used). --float when "
"specified with --remote allows an OpenVPN session to initially connect to a "
"peer at a known address, however if packets arrive from a new address and "
"pass all authentication tests, the new address will take control of the "
"session. This is useful when you are connecting to a peer which holds a "
"dynamic address such as a dial-in user or DHCP client.\n"
"\n"
"Essentially, --float tells OpenVPN to accept authenticated packets from any "
"address, not only the address which was specified in the --remote option.\n"
"\n"
"config: float"
msgstr ""
"Lèt motparten endre IP-adressa og/eller portnummeret sitt, til dømes på grunn av DHCP (dette er standard viss --remote ikkje er brukt). Når --float er gitt saman med --remote, kan ei OpenVPN-økt først kople til ein motpart på ei kjend adresse, men viss pakkar kjem frå ei ny adresse og består alle autentiseringstestar, tek den nye adressa over kontrollen av økta. Dette er nyttig når du koplar til ein motpart med ei dynamisk adresse, som ein oppringt brukar eller DHCP-klient.\n"
"\n"
"I praksis fortel --float OpenVPN at han skal godta autentiserte pakkar frå kva adresse som helst, ikkje berre adressa som er oppgitt med --remote.\n"
"\n"
"config: float"

#: properties/nm-openvpn-dialog.ui:1551
msgid "Specify ma_x routes"
msgstr "Oppgje ma_ks. tal på ruter"

#: properties/nm-openvpn-dialog.ui:1555 properties/nm-openvpn-dialog.ui:1570
msgid ""
"Specify the maximum number of routes the server is allowed to specify.\n"
"config: max-routes <n>"
msgstr ""
"Oppgje maksimalt tal på ruter tenaren har løyve til å oppgje.\n"
"config: max-routes <n>"

#: properties/nm-openvpn-dialog.ui:1615
msgid ""
"Encrypt packets with cipher algorithm. The default is BF-CBC (Blowfish in "
"Cipher Block Chaining mode).\n"
"config: cipher"
msgstr ""
"Krypter pakkar med chifferalgoritme. Standard er BF-CBC (Blowfish i Cipher Block Chaining-modus).\n"
"config: cipher"

#: properties/nm-openvpn-dialog.ui:1632
msgid "Use custom _size of cipher key"
msgstr "_Bruk tilpassa storleik for chiffernøkkel"

#: properties/nm-openvpn-dialog.ui:1636 properties/nm-openvpn-dialog.ui:1650
msgid ""
"Set cipher key size to a custom value. If unspecified, it defaults to cipher-"
"specific size.\n"
"config: keysize <n>"
msgstr ""
"Set storleiken på chiffernøkkelen til ein tilpassa verdi. Viss han ikkje er oppgitt, vert standardstorleiken for chifferet brukt.\n"
"config: keysize <n>"

#: properties/nm-openvpn-dialog.ui:1665
msgid ""
"Authenticate packets with HMAC using message digest algorithm. The default "
"is SHA1.\n"
"config: auth"
msgstr ""
"Autentiser pakkar med HMAC ved hjelp av ein meldingsdigest-algoritme. Standard er SHA1.\n"
"config: auth"

#: properties/nm-openvpn-dialog.ui:1684
msgid "Ci_pher"
msgstr "Ci_pher"

#: properties/nm-openvpn-dialog.ui:1699
msgid "D_ata ciphers"
msgstr "D_atachiffer"

#: properties/nm-openvpn-dialog.ui:1714
msgid "Da_ta ciphers fallback"
msgstr "Reserve for da_tachiffer"

#: properties/nm-openvpn-dialog.ui:1729
msgid ""
"Configure a cipher that is used to fall back to if we could not determine "
"which cipher the peer is willing to use.\n"
"config: data-ciphers-fallback"
msgstr ""
"Set eit chiffer som vert brukt som reserve viss me ikkje kan avgjere kva chiffer motparten vil bruke.\n"
"config: data-ciphers-fallback"

#: properties/nm-openvpn-dialog.ui:1748
msgid ""
"Restrict the allowed ciphers to be negotiated to the ciphers in cipher-list. "
"cipher-list is a colon-separated list of ciphers like AES-256-GCM:AES-128-"
"GCM.\n"
"config: data-ciphers"
msgstr ""
"Avgrens dei tillatne chiffera som kan forhandlast til chiffera i cipher-list. cipher-list er ei kolonskild liste over chiffer som AES-256-GCM:AES-128-GCM.\n"
"config: data-ciphers"

#: properties/nm-openvpn-dialog.ui:1760
msgid "_HMAC Authentication"
msgstr "_HMAC-autentisering"

#: properties/nm-openvpn-dialog.ui:1773
msgid "Disable cipher _negotiation"
msgstr "_Slå av forhandling om chiffer"

#: properties/nm-openvpn-dialog.ui:1777
msgid ""
"Disable cipher negotiation between client and server.\n"
"config: ncp-disable"
msgstr ""
"Slå av chifferforhandling mellom klient og tenar.\n"
"config: ncp-disable"

#: properties/nm-openvpn-dialog.ui:1789
msgid "Verify CRL from _file"
msgstr "_Verifiser CRL frå fil"

#: properties/nm-openvpn-dialog.ui:1794 properties/nm-openvpn-dialog.ui:1821
msgid ""
"Check peer certificate against the specified file in PEM format. A CRL "
"(certificate revocation list) is used when a particular key is compromised "
"but when the overall PKI is still intact."
msgstr ""
"Kontroller motpartssertifikatet mot den oppgitte fila i PEM-format. Ei CRL "
"(sertifikattilbakekallingsliste) vert brukt når ein bestemt nøkkel er "
"kompromittert, men den overordna PKI-en framleis er intakt."

#: properties/nm-openvpn-dialog.ui:1804
msgid "Verify CRL from _directory"
msgstr "_Verifiser CRL frå mappe"

#: properties/nm-openvpn-dialog.ui:1809 properties/nm-openvpn-dialog.ui:1864
msgid ""
"Check peer certificate by looking at files in the specified directory. The "
"directory must contain files named as revoked serial numbers (the files may "
"be empty, the contents are never read)."
msgstr ""
"Sjekk motpartssertifikatet ved å sjå på filer i den oppgitte mappa. Mappa må"
" innehalde filer som er namngjevne etter tilbakekalla serienummer (filene "
"kan vere tomme, innhaldet vert aldri lese)."

#: properties/nm-openvpn-dialog.ui:1830 properties/nm-openvpn-editor.c:103
msgid "(None)"
msgstr "(Ingen)"

#: properties/nm-openvpn-dialog.ui:1923
msgid "Security"
msgstr "Tryggleik"

#: properties/nm-openvpn-dialog.ui:1952
msgid "_Subject Match"
msgstr "_Emnesamsvar"

#: properties/nm-openvpn-dialog.ui:1966
msgid ""
"Subject or Common Name to verify server certificate information against.\n"
"\n"
"config: verify-x509-name subject-or-name [mode]\n"
"config (legacy mode): tls-remote subject-or-name"
msgstr ""
"Emne eller Common Name som tenarsertifikatet skal verifiserast mot.\n"
"\n"
"config: verify-x509-name subject-or-name [mode]\n"
"config (legacy mode): tls-remote subject-or-name"

#: properties/nm-openvpn-dialog.ui:1981
msgid "Server Cert_ificate Check"
msgstr "Kontroll av tenar_sertifikat"

#: properties/nm-openvpn-dialog.ui:1995
msgid ""
"Verify server certificate identification.\n"
"\n"
"When enabled, connection will only succeed if the server certificate matches "
"some expected properties.\n"
"Matching can either apply to the whole certificate subject (all the "
"fields),\n"
"or just the Common Name (CN field).\n"
"\n"
"The legacy option tls-remote is deprecated and removed from OpenVPN 2.4 and "
"newer. Do not use it anymore.\n"
"\n"
"config: verify-x509-name subject-or-name [mode]\n"
"config (legacy mode): tls-remote subject-or-name"
msgstr ""
"Verifiser identifiseringa i tenarsertifikatet.\n"
"\n"
"Når dette er slått på, lykkast tilkoplinga berre viss tenarsertifikatet samsvarar med nokre forventa eigenskapar.\n"
"Samsvaret kan gjelde heile sertifikatemnet (alle felta),\n"
"eller berre Common Name (CN-feltet).\n"
"\n"
"Den eldre innstillinga tls-remote er utdatert og fjerna frå OpenVPN 2.4 og nyare. Ikkje bruk ho lenger.\n"
"\n"
"config: verify-x509-name subject-or-name [mode]\n"
"config (legacy mode): tls-remote subject-or-name"

#: properties/nm-openvpn-dialog.ui:2035
msgid "Verify peer (server) certificate _usage signature"
msgstr "_Verifiser signaturbruk i sertifikatet til motparten (tenaren)"

#: properties/nm-openvpn-dialog.ui:2039
msgid ""
"Require that peer certificate was signed with an explicit key usage and "
"extended key usage based on RFC3280 TLS rules."
msgstr ""
"Krev at motpartssertifikatet er signert med ein eksplisitt nøkkelbruk og "
"utvida nøkkelbruk basert på RFC3280 TLS-reglar."

#: properties/nm-openvpn-dialog.ui:2053
msgid "Remote peer certificate _TLS type"
msgstr "_TLS-type for sertifikatet til motparten"

#: properties/nm-openvpn-dialog.ui:2067
msgid ""
"Require that peer certificate was signed with an explicit key usage and "
"extended key usage based on RFC3280 TLS rules.\n"
"config: remote-cert-tls client|server"
msgstr ""
"Krev at motpartssertifikatet er signert med ein eksplisitt nøkkelbruk og utvida nøkkelbruk basert på RFC3280 TLS-reglar.\n"
"config: remote-cert-tls client|server"

#: properties/nm-openvpn-dialog.ui:2099
msgid "_Verify peer (server) certificate nsCertType designation"
msgstr "_Verifiser nsCertType-merking i sertifikatet til motparten (tenaren)"

#: properties/nm-openvpn-dialog.ui:2103
msgid ""
"Require that peer certificate was signed with an explicit nsCertType "
"designation."
msgstr ""
"Krev at motpartssertifikatet er signert med ei eksplisitt nsCertType-"
"merking."

#: properties/nm-openvpn-dialog.ui:2119
msgid "_Remote peer certificate nsCert designation"
msgstr "_nsCert-merking i sertifikatet til motparten"

#: properties/nm-openvpn-dialog.ui:2133
msgid ""
"Require that peer certificate was signed with an explicit nsCertType "
"designation.\n"
"config: ns-cert-type client|server"
msgstr ""
"Krev at motpartssertifikatet er signert med ei eksplisitt nsCertType-merking.\n"
"config: ns-cert-type client|server"

#: properties/nm-openvpn-dialog.ui:2175
msgid "Key _Direction"
msgstr "_Nøkkelretning"

#: properties/nm-openvpn-dialog.ui:2189
msgid ""
"Add an additional layer of HMAC authentication on top of the TLS control "
"channel to protect against DoS attacks. In case of TLS-Crypt mode, the "
"control channel is also encrypted.\n"
"config: tls-auth <file> [direction] | tls-crypt <file>"
msgstr ""
"Legg til eit ekstra lag med HMAC-autentisering oppå TLS-kontrollkanalen for å verne mot DoS-åtak. I TLS-Crypt-modus vert kontrollkanalen òg kryptert.\n"
"config: tls-auth <file> [direction] | tls-crypt <file>"

#: properties/nm-openvpn-dialog.ui:2233
msgid ""
"Direction parameter for static key mode.\n"
"If key direction is used, it must be the opposite of that used on the VPN "
"peer. For example, if the peer uses “1”, this connection must use “0”. If "
"you are unsure what value to use, contact your system administrator.\n"
"config: tls-auth <file> [direction]"
msgstr ""
"Retningsparameter for statisk nøkkelmodus.\n"
"Viss nøkkelretning vert brukt, må han vere motsett av den som vert brukt hos VPN-motparten. Til dømes, viss motparten nyttar «1», må denne tilkoplinga bruke «0». Viss du er usikker på kva verdi du skal bruke, ta kontakt med systemadministratoren din.\n"
"config: tls-auth <file> [direction]"

#: properties/nm-openvpn-dialog.ui:2253
msgid "Key _File"
msgstr "_Nøkkelfil"

#: properties/nm-openvpn-dialog.ui:2267
msgid "_Mode"
msgstr "_Modus"

#: properties/nm-openvpn-dialog.ui:2280 properties/nm-openvpn-dialog.ui:2387
msgid "Add an additional layer of encryption or HMAC authentication."
msgstr "Legg til eit ekstra lag med kryptering eller HMAC-autentisering."

#: properties/nm-openvpn-dialog.ui:2300
msgid "_Extra Certificates"
msgstr "_Ekstra sertifikat"

#: properties/nm-openvpn-dialog.ui:2313
msgid ""
"Specify a file containing one or more PEM certs (concatenated together) that "
"complete the local certificate chain.\n"
"config: extra-certs <file>"
msgstr ""
"Oppgje ei fil som inneheld eitt eller fleire PEM-sertifikat (sette saman) som fullfører den lokale sertifikatkjeda.\n"
"config: extra-certs <file>"

#: properties/nm-openvpn-dialog.ui:2356
msgid "TLS ci_pher string"
msgstr "TLS-chi_ffer-streng"

#: properties/nm-openvpn-dialog.ui:2369
msgid ""
"Set a value for the --tls-cipher parameter. This can be useful for working "
"with VPNs using deprecated hashing schemes."
msgstr ""
"Set ein verdi for parameteren --tls-cipher. Dette kan vere nyttig for å "
"arbeide med VPN-ar som nyttar utdaterte hash-skjema."

#: properties/nm-openvpn-dialog.ui:2390
msgid "Additional TLS authentication or encryption"
msgstr "Ekstra TLS-autentisering eller -kryptering"

#: properties/nm-openvpn-dialog.ui:2417
msgid "Controls min and max version allowed for TLS."
msgstr "Styrer minste og høgaste versjon som er tillaten for TLS."

#: properties/nm-openvpn-dialog.ui:2420
msgid "TLS version control"
msgstr "TLS-versjonskontroll"

#: properties/nm-openvpn-dialog.ui:2445
msgid "TLS mi_n version"
msgstr "Minste TLS-_versjon"

#: properties/nm-openvpn-dialog.ui:2458
msgid ""
" Sets the minimum TLS version we will accept from the peer (default is "
"\"1.0\").  Examples for version include \"1.0\", \"1.1\", or \"1.2\"."
msgstr ""
" Set den lågaste TLS-versjonen me godtek frå motparten (standard er «1.0»). "
"Døme på versjonar er «1.0», «1.1» eller «1.2»."

#: properties/nm-openvpn-dialog.ui:2470
msgid "TLS ma_x version"
msgstr "Høgaste TLS-ver_sjon"

#: properties/nm-openvpn-dialog.ui:2483
msgid ""
"Set the maximum TLS version we will use (default is the highest version "
"supported).  Examples for version include \"1.0\", \"1.1\", or \"1.2\"."
msgstr ""
"Set den høgaste TLS-versjonen me vil bruke (standard er den høgaste støtta "
"versjonen). Døme på versjonar er «1.0», «1.1» eller «1.2»."

#: properties/nm-openvpn-dialog.ui:2493
msgid "_or highest"
msgstr "_eller høgaste"

#: properties/nm-openvpn-dialog.ui:2496
msgid ""
"If set and version is not recognized, we will only accept the highest TLS "
"version supported by the local SSL implementation."
msgstr ""
"Viss dette er sett og versjonen ikkje vert kjend att, godtek me berre den "
"høgaste TLS-versjonen som den lokale SSL-implementasjonen støttar."

#: properties/nm-openvpn-dialog.ui:2525
msgid "TLS Authentication"
msgstr "TLS-autentisering"

#: properties/nm-openvpn-dialog.ui:2546
msgid ""
"Proxy type: HTTP or Socks.\n"
"config: http-proxy or socks-proxy"
msgstr ""
"Proxytype: HTTP eller Socks.\n"
"config: http-proxy or socks-proxy"

#: properties/nm-openvpn-dialog.ui:2566
msgid "Proxy _Type"
msgstr "_Proxytype"

#: properties/nm-openvpn-dialog.ui:2582
msgid ""
"<i>Select this option if your organization requires the use of a proxy "
"server to access the Internet.</i>"
msgstr ""
"<i>Vel dette valet viss organisasjonen din krev at ein proxy-tenar vert "
"brukt for å få tilgang til internett.</i>"

#: properties/nm-openvpn-dialog.ui:2597
msgid "S_erver Address"
msgstr "_Tenaradresse"

#: properties/nm-openvpn-dialog.ui:2615
msgid ""
"Connect to remote host through a proxy with this address.\n"
"config: http-proxy or socks-proxy"
msgstr ""
"Kople til den eksterne verten via ein proxy med denne adressa.\n"
"config: http-proxy or socks-proxy"

#: properties/nm-openvpn-dialog.ui:2628
msgid "_Port"
msgstr "_Port"

#: properties/nm-openvpn-dialog.ui:2645
msgid ""
"Connect to remote host through a proxy with this port.\n"
"config: http-proxy or socks-proxy"
msgstr ""
"Kople til den eksterne verten via ein proxy med denne porten.\n"
"config: http-proxy or socks-proxy"

#: properties/nm-openvpn-dialog.ui:2666
msgid "_Retry indefinitely when errors occur"
msgstr "_Prøv på nytt utan avgrensing når feil oppstår"

#: properties/nm-openvpn-dialog.ui:2670
msgid ""
"Retry indefinitely on proxy errors. It simulates a SIGUSR1 reset.\n"
"config: http-proxy-retry or socks-proxy-retry"
msgstr ""
"Prøv på nytt utan avgrensing ved proxy-feil. Det simulerer ei SIGUSR1-nullstilling.\n"
"config: http-proxy-retry or socks-proxy-retry"

#: properties/nm-openvpn-dialog.ui:2684
msgid "Proxy _Username"
msgstr "_Proxy-brukarnamn"

#: properties/nm-openvpn-dialog.ui:2699
msgid "Proxy Passwor_d"
msgstr "_Proxy-passord"

#: properties/nm-openvpn-dialog.ui:2714
msgid "HTTP/Socks proxy username passed to OpenVPN when prompted for it."
msgstr ""
"Brukarnamn til HTTP/Socks-proxy som vert sendt til OpenVPN når det vert bedt"
" om det."

#: properties/nm-openvpn-dialog.ui:2725
msgid "HTTP/Socks proxy password passed to OpenVPN when prompted for it."
msgstr ""
"Passordet for HTTP/Socks-proxy som vert sendt til OpenVPN når det vert bedt "
"om det."

#: properties/nm-openvpn-dialog.ui:2735
msgid "_Show password"
msgstr "_Vis passord"

#: properties/nm-openvpn-dialog.ui:2762
msgid "Proxies"
msgstr "Proxyar"

#: properties/nm-openvpn-dialog.ui:2783
msgid "Path mtu _discovery"
msgstr "_Oppdaging av MTU for stien"

#: properties/nm-openvpn-dialog.ui:2817
msgid "Connect _timeout"
msgstr "_Tidsavbrot for tilkopling"

#: properties/nm-openvpn-dialog.ui:2822 properties/nm-openvpn-dialog.ui:2835
msgid ""
"The timeout in seconds before trying the next server. This timeout includes "
"proxy and TCP connect timeouts.\n"
"config: connect-timeout <n> | server-poll-timeout <n>"
msgstr ""
"Tidsavbrotet i sekund før neste tenar vert prøvd. Dette tidsavbrotet omfattar tidsavbrot for proxy og TCP-tilkopling.\n"
"config: connect-timeout <n> | server-poll-timeout <n>"

#: properties/nm-openvpn-dialog.ui:2838
msgid "0"
msgstr "0"

#: properties/nm-openvpn-dialog.ui:2848
msgid "_Push peer info"
msgstr "_Send motpartsinformasjon"

#: properties/nm-openvpn-dialog.ui:2852
msgid ""
"Push additional information about the client to server.\n"
"config: push-peer-info"
msgstr ""
"Send tilleggsinformasjon om klienten til tenaren.\n"
"config: push-peer-info"

#: properties/nm-openvpn-dialog.ui:2869
msgid "Misc"
msgstr "Diverse"

#: properties/nm-openvpn-dialog.ui:2902
msgid "Choose an OpenVPN static key…"
msgstr "Vel ein statisk OpenVPN-nøkkel …"

#: properties/nm-openvpn-dialog.ui:2919 properties/nm-openvpn-dialog.ui:2972
#: properties/nm-openvpn-dialog.ui:3026 properties/nm-openvpn-dialog.ui:3079
#: properties/nm-openvpn-dialog.ui:3132
msgid "_Select"
msgstr "_Vel"

#: properties/nm-openvpn-dialog.ui:2955
msgid "Choose CRL file"
msgstr "Vel CRL-fil"

#: properties/nm-openvpn-dialog.ui:3009
msgid "Choose CRL directory"
msgstr "Vel CRL-mappe"

#: properties/nm-openvpn-dialog.ui:3062
msgid "Choose a key file"
msgstr "Vel ei nøkkelfil"

#: properties/nm-openvpn-dialog.ui:3115
msgid "Choose extra certificate file"
msgstr "Vel ekstra sertifikatfil"

#: properties/nm-openvpn-editor.c:785
msgid "OpenVPN Static Keys (*.key)"
msgstr "Statiske OpenVPN-nøklar (*.key)"

#: properties/nm-openvpn-editor.c:944 properties/nm-openvpn-editor.c:1038
msgid "Default"
msgstr "Standard"

#: properties/nm-openvpn-editor.c:1022
msgid "RSA MD-4"
msgstr "RSA MD-4"

#: properties/nm-openvpn-editor.c:1023
msgid "MD-5"
msgstr "MD-5"

#: properties/nm-openvpn-editor.c:1024
msgid "SHA-1"
msgstr "SHA-1"

#: properties/nm-openvpn-editor.c:1025
msgid "SHA-224"
msgstr "SHA-224"

#: properties/nm-openvpn-editor.c:1026
msgid "SHA-256"
msgstr "SHA-256"

#: properties/nm-openvpn-editor.c:1027
msgid "SHA-384"
msgstr "SHA-384"

#: properties/nm-openvpn-editor.c:1028
msgid "SHA-512"
msgstr "SHA-512"

#: properties/nm-openvpn-editor.c:1029
msgid "RIPEMD-160"
msgstr "RIPEMD-160"

#: properties/nm-openvpn-editor.c:1087
msgid "Don’t verify certificate identification"
msgstr "Ikkje verifiser sertifikatidentifikasjon"

#: properties/nm-openvpn-editor.c:1093
msgid "Verify whole subject exactly"
msgstr "Verifiser heile emnet nøyaktig"

#: properties/nm-openvpn-editor.c:1099
msgid "Verify name exactly"
msgstr "Verifiser namnet nøyaktig"

#: properties/nm-openvpn-editor.c:1105
msgid "Verify name by prefix"
msgstr "Verifiser namnet med prefiks"

#: properties/nm-openvpn-editor.c:1111
msgid "Verify subject partially (legacy mode, strongly discouraged)"
msgstr "Verifiser emnet delvis (eldre modus, sterkt frårådd)"

#: properties/nm-openvpn-editor.c:1224 properties/nm-openvpn-editor.c:1296
msgid "Server"
msgstr "Tenar"

#: properties/nm-openvpn-editor.c:1229 properties/nm-openvpn-editor.c:1301
msgid "Client"
msgstr "Klient"

#: properties/nm-openvpn-editor.c:1628
